# Public frontend URL for the hosted CAD API.
# Example:
# VITE_CAD_API_BASE_URL=https://cad-api.yourdomain.com/api/cad
VITE_CAD_API_BASE_URL=https://cad-api.yourdomain.com/api/cad

# Keep VITE_CAD_BACKEND_PROXY_TARGET unset in production.
# This variable is only useful for local dev proxy overrides.
# VITE_CAD_BACKEND_PROXY_TARGET=http://localhost:4000
